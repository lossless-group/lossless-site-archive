---
import AuthorHandle from '@components/basics/AuthorHandle.astro';
import TagChip from '@components/tool-components/TagChip.astro';

// Type definitions for trademarks data
type TrademarkEntry = Record<string, string>;
interface AugmenterTrademarks {
  [key: string]: TrademarkEntry[];
}

// Import the trademarks data in script tag
const trademarks: AugmenterTrademarks = {
  'Perplexity AI': [
    {'PerplexityAI_Trademark--Lighter': 'https://ik.imagekit.io/xvpgfijuw/lossless-content-embeds/trademark__PerplexityAI--Lighter.svg'},
    {'PerplexityAI_appIcon--Brand': 'https://ik.imagekit.io/xvpgfijuw/lossless-content-embeds/appIcon__PerplexityAI--Lighter--Brand.svg'}
  ],
  'Windsurf': [
    {'Windsurf_Trademark--Lightest': 'https://ik.imagekit.io/xvpgfijuw/lossless-content-embeds/trademark__Windsurf--Lightest.svg'},
    {'Windsurf_appIcon--Brand': 'https://ik.imagekit.io/xvpgfijuw/lossless-content-embeds/icon__Windsurf--Lightest.svg'}
  ]
};

interface Props {
  categories?: string[];
  semanticVersion?: string;
  authorForHandle?: string | string[];
  // Support both underscore and camelCase variants
  augmented_with?: string;
  augmented_by?: string;
  // Legacy camelCase support
  augmentedWith?: string;
  augmentedBy?: string;
  formattedDateModified?: string | null;
  formattedDateCreated?: string | null;
  tags?: string[];
  id?: string;
  path?: string;
  contentType?: string;
}



// Helper function to find trademark image URL with flexible matching
function findTrademarkImage(augmenterName: string | undefined): string | null {
  if (!augmenterName) return null;
  
  // Try exact match first
  let augmenterData = trademarks[augmenterName];
  
  // If no exact match, try to find a partial match
  if (!augmenterData) {
    const matchingKey = Object.keys(trademarks).find(key => 
      augmenterName?.toLowerCase().includes(key.toLowerCase()) || 
      key.toLowerCase().includes(augmenterName.toLowerCase())
    );
    
    if (matchingKey) {
      augmenterData = trademarks[matchingKey];
    } else {
      return null;
    }
  }
  
  if (!Array.isArray(augmenterData) || augmenterData.length === 0) {
    return null;
  }
  
  // First try to find a trademark entry
  let trademarkEntry = augmenterData.find(item => {
    const value = Object.values(item)[0];
    return value && typeof value === 'string' && value.toLowerCase().includes('trademark');
  });
  
  // If no trademark entry found, just take the first available image
  if (!trademarkEntry && augmenterData.length > 0) {
    trademarkEntry = augmenterData[0];
  }
  
  if (!trademarkEntry) return null;
  
  const value = Object.values(trademarkEntry)[0];
  return typeof value === 'string' ? value : null;
}

// Process component props
const props = Astro.props as Props;
const categories = props.categories || [];
const semanticVersion = props.semanticVersion;
const authorForHandle = props.authorForHandle;
const formattedDateModified = props.formattedDateModified;
const formattedDateCreated = props.formattedDateCreated;
const tags = props.tags || [];
const id = props.id;
const path = props.path;
const contentType = props.contentType;

// Handle all possible variations of the augmented with/by property
const augmentedWith = 
  props.augmented_with || 
  props.augmentedWith || 
  props.augmented_by || 
  props.augmentedBy;

// Process the augmented with data
const augmentedWithData = (() => {
  if (!augmentedWith) return null;
  const imageUrl = findTrademarkImage(augmentedWith);
  return { augmentedWith, imageUrl };
})();

---

<aside class="info-sidebar">
  <h2 class="info-title">Document Info</h2>
  <div class="info-scroll-area">
    <div class="info-list">
      {augmentedWithData && (
        <div class="info-item">
          <div class="info-label">Augmented with</div>
          <div class="info-value">
            {augmentedWithData.imageUrl ? (
              <img 
                src={augmentedWithData.imageUrl}
                alt={augmentedWithData.augmentedWith}
                class="trademark-image"
                width="24"
                height="24"
                loading="lazy"
                title={augmentedWithData.augmentedWith}
              />
            ) : (
              augmentedWithData.augmentedWith
            )}
          </div>
        </div>
      )}

      {categories.length > 0 && (
        <div class="info-item">
          <div class="info-label">Categories</div>
          <div class="info-value">
            {categories.map(category => (
              <span class="category-tag">{category}</span>
            ))}
          </div>
        </div>
      )}

      {semanticVersion && (
        <div class="info-item">
          <div class="info-label">Version</div>
          <div class="info-value">{semanticVersion}</div>
        </div>
      )}

      {authorForHandle && (
        <div class="info-item">
          <div class="info-label">Author</div>
          <div class="info-value">
            <AuthorHandle 
              authors={Array.isArray(authorForHandle) ? authorForHandle : [authorForHandle]} 
              showName={true} 
              showRole={false} 
            />
          </div>
        </div>
      )}

      {formattedDateModified && (
        <div class="info-item">
          <div class="info-label">Last Updated</div>
          <div class="info-value">{formattedDateModified}</div>
        </div>
      )}

      {formattedDateCreated && (
        <div class="info-item">
          <div class="info-label">Created</div>
          <div class="info-value">{formattedDateCreated}</div>
        </div>
      )}

      {id && (
        <div class="info-item">
          <div class="info-label">Document ID</div>
          <div class="info-value">{id}</div>
        </div>
      )}

      {path && (
        <div class="info-item">
          <div class="info-label">Path</div>
          <div class="info-value">{path}</div>
        </div>
      )}

      {contentType && (
        <div class="info-item">
          <div class="info-label">Content Type</div>
          <div class="info-value">{contentType}</div>
        </div>
      )}

      {tags.length > 0 && (
        <div class="info-item tags-section">
          <div class="info-label">Tags</div>
          <div class="tags-container">
            {tags.map(tag => (
              <TagChip tagString={tag} />
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</aside>

<style>
  .info-item {
    margin: 0.75rem 0;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--clr-lossless-border);
  }
  
  .info-item:last-child {
    border-bottom: none;
  }
  
  .info-label {
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--clr-lossless-muted);
    margin-bottom: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  
  .info-value {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--clr-lossless-text);
  }
  
  .info-value img.trademark-image {
    border-radius: 4px;
    vertical-align: middle;
  }
  
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  
  .trademark-image {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
  }
  
  .category-tag {
    display: inline-block;
    background-color: var(--clr-lossless-attn-action, var(--purple-heart));
    color: white;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    margin-right: 0.25rem;
    margin-bottom: 0.25rem;
  }
  
  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  
  .tags-section {
    margin-top: 1.5rem;
  }

  .info-sidebar {
    position: sticky;
    top: 1rem;
    margin-right: 1.5rem;
    padding: 1.25rem;
    background: var(--clr-lossless-bg-secondary);
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .info-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    color: var(--clr-lossless-text);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--clr-lossless-border);
  }

  .info-scroll-area {
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  /* Custom scrollbar */
  .info-scroll-area::-webkit-scrollbar {
    width: 6px;
  }

  .info-scroll-area::-webkit-scrollbar-track {
    background: var(--clr-lossless-bg);
    border-radius: 3px;
  }

  .info-scroll-area::-webkit-scrollbar-thumb {
    background: var(--clr-lossless-muted);
    border-radius: 3px;
  }
</style>