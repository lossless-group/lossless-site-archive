---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Get all slide decks from the slides collection with proper typing
type SlideEntry = CollectionEntry<'slides'>;
const slideDecks = await getCollection('slides') as SlideEntry[];

// Set page metadata
const title = 'Slide Decks';
const description = 'Browse all available slide presentations';
---

<Layout title={title} description={description}>
  <div class="container mx-auto px-4 py-8">
    <header class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Slide Decks</h1>
      <p class="text-xl text-gray-600">Browse and present your slide decks</p>
    </header>

    {slideDecks.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {slideDecks.map((deck) => (
          <a 
            href={`/slides/slides/${deck.id}`}
            class="block p-6 bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow hover:border-blue-500"
          >
            <h2 class="text-xl font-semibold text-gray-900 mb-2">
              {deck.data.title || deck.id.replace(/-/g, ' ').replace(/\.md$/, '')}
            </h2>
            {deck.data.description && (
              <p class="text-gray-600 mb-4">{deck.data.description}</p>
            )}
            <div class="flex items-center text-sm text-gray-500">
              <span class="mr-4">
                {deck.data.date_created?.toLocaleDateString() || 'No date'}
              </span>
              {deck.data.tags?.length > 0 && (
                <span class="inline-flex items-center">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
                  </svg>
                  {deck.data.tags[0]}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-gray-500">No slide decks found.</p>
      </div>
    )}
  </div>
</Layout>
